* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #f4f7f6; 
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #333;
    line-height: 1.6;
}


.navbar {
    background-color: #1e293b; 
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 50px;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 20px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-weight: 50px;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #38bdf8; 
}


.hero {
    text-align: center;
    padding: 80px 20px;
    background: linear-gradient(135deg, #1e293b, #0f172a);
    color: white;
}

.hero h1 {
    color: #38bdf8;
    font-size: 45px;
    margin-bottom: 15px;
}

.hero p {
    font-size: 18px;
    color: #cbd5e1;
    margin-bottom: 10px;
}


.about {
    padding: 40px 20px;
}

.card {
    background-color: white;
    width: 100%;
    max-width: 500px; 
    padding: 30px;
    margin: 0 auto;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    text-align: center;
}

.card h2 {
    color: #1e293b;
    margin-bottom: 15px;
}

.card p {
    color: #64748b;
    font-size: 16px;
    margin-bottom: 20px;
}


.skills {
    padding: 40px 20px;
    text-align: center;
    background-color: #ecf1f0;
}

.skills h2 {
    margin-bottom: 25px;
    color: #1e293b;
}

.skills-container {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
}

.skill-box {
    background-color: #38bdf8;
    color: #1e293b;
    padding: 12px 25px;
    border-radius: 8px;
    font-weight: bold;
    font-size: 16px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}


.contact {
    padding: 40px 20px;
    text-align: center;
    max-width: 400px;
    margin: 0 auto;
}

.contact h2 {
    margin-bottom: 20px;
}

.contact form {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.contact input, .contact textarea {
    padding: 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 15px;
}

.contact textarea {
    height: 100px;
    resize: none;
}

.btn {
    background-color: #38bdf8;
    color: #1e293b;
    padding: 10px 25px;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    margin-top: 10px;
}

.btn:hover {
    background-color: #0ea5e9;
    transform: scale(1.05);
}


.footer {
    background-color: #0f172a;
    color: #94a3b8;
    text-align: center;
    padding: 20px;
    margin-top: 40px;
    font-size: 14px;
}



